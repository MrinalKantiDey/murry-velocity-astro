---
/**
 * Logo Component
 *
 * Renders the Murry Street Media lockup: the lime "M" road icon plus the
 * "MURRY STREET MEDIA" wordmark, as inline SVG (src/components/ui/marketing/Logo/logo-paths.ts).
 *
 * The lime shape never changes. The icon's road-dash accent paths sit in
 * transparent negative space (not on top of the lime fill), so on the 'full'
 * lockup — rendered directly against the header/footer background — they
 * follow the same dark/light color-swap as the wordmark, or they'd vanish
 * against a dark background. On the standalone 'logomark' variant they stay
 * fixed dark, since that's used decoratively on backgrounds the page author
 * already chose deliberately (e.g. a white card) rather than on the
 * theme-following header/footer background.
 */
import siteConfig from '@/config/site.config';
import { cn } from '@/lib/cn';
import {
  ICON_VIEWBOX,
  ICON_BASE_PATH,
  ICON_ACCENT_PATHS,
  WORDMARK_VIEWBOX,
  WORDMARK_PATHS,
} from './logo-paths';

interface Props {
  /** Size preset (controls icon/wordmark height) */
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Force dark-background wordmark (for dark/invert backgrounds) */
  forceDark?: boolean;
  /** 'logomark' = icon only. 'full' = icon + wordmark lockup. */
  variant?: 'logomark' | 'full';
  /** Additional CSS classes (applied to the wrapping span) */
  class?: string;
  /** Native browser loading behavior — kept for API compatibility; inline SVG loads with the page regardless */
  loading?: 'eager' | 'lazy';
}

const {
  size = 'md',
  forceDark = false,
  variant = 'logomark',
  class: className,
} = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'h-6',
  md: 'h-8',
  lg: 'h-10',
  xl: 'h-16',
  '2xl': 'h-28',
};

const sizeClass = sizeClasses[size] || sizeClasses.md;
const logoAlt = siteConfig.branding.logo.alt;

const adaptiveFillClass = cn(
  'transition-colors',
  forceDark ? 'fill-white' : 'fill-[#231F20] dark:fill-white'
);
const wordmarkClass = cn('w-auto', adaptiveFillClass);
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    viewBox={ICON_VIEWBOX}
    class:list={[sizeClass, 'w-auto shrink-0']}
    role={variant === 'logomark' ? 'img' : undefined}
    aria-label={variant === 'logomark' ? logoAlt : undefined}
    aria-hidden={variant === 'full' ? 'true' : undefined}
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d={ICON_BASE_PATH} fill="#DFE11D" />
    {variant === 'full' ? (
      <g class:list={[adaptiveFillClass]} fill="currentColor">
        {ICON_ACCENT_PATHS.map((d) => <path d={d} />)}
      </g>
    ) : (
      <g fill="#231F20">
        {ICON_ACCENT_PATHS.map((d) => <path d={d} />)}
      </g>
    )}
  </svg>

  {variant === 'full' && (
    <svg
      viewBox={WORDMARK_VIEWBOX}
      class:list={[sizeClass, wordmarkClass]}
      role="img"
      aria-label={logoAlt}
      xmlns="http://www.w3.org/2000/svg"
    >
      {WORDMARK_PATHS.map((d) => <path d={d} />)}
    </svg>
  )}
</span>
